# Local settings for the accounts API (npm run dev). Copy to `.dev.vars`
# (git-ignored) and fill in from your *development* Auth0 tenant, never the
# live one. The same names are set on each Cloudflare Pages project.
# See design/backend-v1-spec.md §5 and README "Accounts".

# Auth0 tenant domain, e.g. dev-xxxx.us.auth0.com
AUTH0_DOMAIN=

# "Regular Web Application" (sign-in). Settings tab.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# "Machine to Machine" application authorised for the Auth0 Management API
# with the permissions read:users, delete:users, create:user_tickets.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# Your own Auth0 user ID (auth0|…) once you've signed up, to be the admin. Optional.
ADMIN_AUTH0_ID=

# Any long random string, e.g. the output of: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
RECOVERY_PEPPER=
